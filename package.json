{
	"name": "sentencify",
	"version": "1.3.5",
	"description": "Detects sentence types and fixes punctuation in English, Japanese, German, Spanish, and French.",
	"keywords": [
		"sentence",
		"punctuation",
		"capitalization",
		"detection",
		"type-detection",
		"grammar",
		"multilingual",
		"en",
		"ja",
		"de",
		"es",
		"fr"
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/SheikhAminul/sentencify.git"
	},
	"bugs": {
		"url": "https://github.com/SheikhAminul/sentencify/issues"
	},
	"homepage": "https://github.com/SheikhAminul/sentencify#readme",
	"author": "Sheikh Aminul <aminulfse@gmail.com>",
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"engines": {
		"node": ">=20"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "eslint src",
		"test": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test \".test-build/test/*.test.js\"",
		"test:accuracy": "rm -rf .test-build && tsc -p tsconfig.test.json && node --test \".test-build/test/en-accuracy.test.js\"",
		"verify:package": "npm run lint && npm run test && npm run build"
	},
	"devDependencies": {
		"@types/node": "22.20.1",
		"eslint": "^9.0.0",
		"tsup": "^8.5.1",
		"typescript": "^5.6.0",
		"typescript-eslint": "^8.0.0"
	}
}